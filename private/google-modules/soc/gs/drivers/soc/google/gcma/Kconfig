config GCMA_VENDOR
	tristate "Pixel GCMA accounting and diagnostics"
	depends on GCMA && GCMA_SYSFS && ANDROID_VENDOR_HOOKS
	help
	  Preserve Pixel memory accounting, allocation latency statistics and
	  diagnostic interfaces while using the Android common GCMA allocator.
