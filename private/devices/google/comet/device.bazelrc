build:comet --config=zumapro_base
build:comet --//private/devices/google/common:kernel=//private/devices/google/comet:comet/kernel

# GrapheneOS uses MTE instead of slab canaries on this device.
build:comet --defconfig_fragment=//private/devices/google/common:disable_slab_canary.fragment
