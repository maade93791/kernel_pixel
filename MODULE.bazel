"""Kleaf: Build Android kernels with Bazel."""

module(
    name = "kleaf",
    version = "0.0.0",
)

new_kleaf_local_repository = use_repo_rule(
    "//build/kernel/kleaf/impl:local_repository.bzl",
    "new_kleaf_local_repository",
)

kleaf_local_repository = use_repo_rule(
    "//build/kernel/kleaf/impl:local_repository.bzl",
    "kleaf_local_repository",
)

new_kleaf_local_repository(
    name = "argp-standalone",
    build_file = "build/kernel/kleaf/argp-standalone.BUILD",
    path = "external/argp-standalone",
)

new_kleaf_local_repository(
    name = "avb_test",
    build_file = "build/kernel/kleaf/avb_test.BUILD",
    path = "external/avb/test",
)

new_kleaf_local_repository(
    name = "dwarves",
    build_file = "build/kernel/kleaf/dwarves.BUILD",
    path = "external/dwarves",
)

new_kleaf_local_repository(
    name = "libcap",
    build_file = "build/kernel/kleaf/libcap.BUILD",
    path = "external/libcap",
)

new_kleaf_local_repository(
    name = "libcap_ng",
    build_file = "build/kernel/kleaf/libcap_ng.BUILD",
    path = "external/libcap-ng",
)

new_kleaf_local_repository(
    name = "lz4",
    build_file = "build/kernel/kleaf/lz4.BUILD",
    path = "external/lz4",
)

new_kleaf_local_repository(
    name = "obstack",
    build_file = "build/kernel/kleaf/obstack.BUILD",
    path = "external/obstack",
)

new_kleaf_local_repository(
    name = "toybox",
    build_file = "build/kernel/kleaf/toybox.BUILD",
    path = "external/toybox",
)

new_kleaf_local_repository(
    name = "zlib",
    build_file = "build/kernel/kleaf/zlib.BUILD",
    path = "external/zlib",
)

new_kleaf_local_repository(
    name = "zopfli",
    build_file = "build/kernel/kleaf/zopfli.BUILD",
    path = "external/zopfli",
)

new_kleaf_local_repository(
    name = "pigz",
    build_file = "build/kernel/kleaf/pigz.BUILD",
    path = "external/pigz",
)

kleaf_local_repository(
    name = "kmod",
    fallback_build_file = "build/kernel/kleaf/fallback_kmod.BUILD",
    path = "external/kmod",
)

kleaf_local_repository(
    name = "dtc",
    fallback_build_file = "build/kernel/kleaf/fallback_dtc.BUILD",
    path = "external/dtc",
)

new_kleaf_local_repository(
    name = "prebuilt_ndk",
    build_file = "build/kernel/kleaf/ndk.BUILD",
    path_candidates = [
        # do not sort
        "prebuilts/ndk-r27",
        "prebuilts/ndk-r26",
    ],
)

kleaf_local_repository(
    name = "prebuilt_rust",
    path = "prebuilts/rust-toolchain/linux-x86",
)

# GBL deps, all should have mandatory=False

# Hack for b/328465178
new_kleaf_local_repository(
    name = "rules_rust_tinyjson",
    build_file = "external/bazelbuild-rules_rust/util/process_wrapper/BUILD.tinyjson.bazel",
    mandatory = False,
    path = "external/rust/android-crates-io/crates/tinyjson",
)

internal_deps = use_extension("@rules_rust//rust/private:internal_extensions.bzl", "i")

override_repo(internal_deps, "rules_rust_tinyjson")
# END GBL deps.

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# Inhibits rules_rust from registering default toolchains to ensure hermetic builds (no internet downloads).
rust.toolchain(versions = [])

kernel_toolchain_ext = use_extension("//build/kernel/kleaf:kernel_toolchain_ext.bzl", "kernel_toolchain_ext")
use_repo(kernel_toolchain_ext, "kernel_toolchain_info")
use_repo(kernel_toolchain_ext, "kleaf_clang_toolchain")
use_repo(kernel_toolchain_ext, "kleaf_host_tools")
use_repo(kernel_toolchain_ext, "kleaf_rust_toolchain")

register_toolchains(
    "@kleaf_clang_toolchain//:all",
    "@kleaf_rust_toolchain//:all",
    "//build/kernel:devicetree_toolchain",
    "//build/kernel:hermetic_tools_toolchain",
    "//prebuilts/build-tools:py_exec_tools_toolchain",
    "//prebuilts/build-tools:py_toolchain_musl",
)

# TODO(b/276493276): Resolve the issue of these versions getting outdated.
bazel_dep(
    name = "abseil-py",
    version = "2.1.0",
    repo_name = "io_abseil_py",
)
bazel_dep(
    name = "bazel_skylib",
    version = "1.8.1",
)

bazel_dep(
    name = "gbl",
    dev_dependency = True,
)

bazel_dep(
    name = "package_metadata",
    version = "0.0.5",
)
bazel_dep(
    name = "platforms",
    version = "1.0.0",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.11",
)
bazel_dep(
    name = "rules_devicetree",
    version = "0.1.4",
)
bazel_dep(
    name = "rules_pkg",
    version = "1.1.0",
)
bazel_dep(
    name = "rules_python",
    version = "1.5.1",
)
bazel_dep(
    name = "rules_shell",
    version = "0.5.0",
)
bazel_dep(
    name = "rules_rust",
    version = "0.60.0",
)
bazel_dep(
    name = "rules_rust_bindgen",
    version = "0.60.0",
)
bazel_dep(
    name = "zstd",
    version = "1.5.7",
)

# For --config=docs
bazel_dep(
    name = "stardoc",
    version = "0.8.1",
    dev_dependency = True,
    repo_name = "io_bazel_stardoc",
)

local_path_override(
    module_name = "abseil-py",
    path = "external/python/absl-py",
)

local_path_override(
    module_name = "bazel_features",
    path = "external/bazel-contrib-bazel_features",
)

local_path_override(
    module_name = "bazel_skylib",
    path = "external/bazel-skylib",
)

local_path_override(
    module_name = "package_metadata",
    path = "external/bazel-contrib-supply-chain/metadata",
)

local_path_override(
    module_name = "platforms",
    path = "external/bazelbuild-platforms",
)

local_path_override(
    module_name = "rules_cc",
    path = "external/bazelbuild-rules_cc",
)

local_path_override(
    module_name = "rules_devicetree",
    path = "external/bazel-contrib-rules_devicetree",
)

local_path_override(
    module_name = "rules_license",
    path = "external/bazelbuild-rules_license",
)

local_path_override(
    module_name = "rules_pkg",
    path = "external/bazelbuild-rules_pkg",
)

local_path_override(
    module_name = "rules_python",
    path = "external/bazelbuild-rules_python",
)

local_path_override(
    module_name = "rules_shell",
    path = "external/bazelbuild-rules_shell",
)

local_path_override(
    module_name = "rules_rust",
    path = "external/bazelbuild-rules_rust",
)

local_path_override(
    module_name = "rules_rust_bindgen",
    path = "external/bazelbuild-rules_rust/extensions/bindgen",
)

local_path_override(
    module_name = "zstd",
    path = "external/zstd",
)

# Pixel workspace additions. Keep the Kleaf dependency declarations above aligned
# with build/kernel/kleaf/bzlmod/bazel.MODULE.bazel.
new_kleaf_local_repository(
    name = "bionic",
    build_file = "private/devices/google/common/workspace/bionic.BUILD.bazel",
    path = "external/bionic",
)
